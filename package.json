{
  "name": "magpie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "format": "prettier --no-config --single-quote --trailing-comma none --print-width 100 --write .",
    "format:check": "prettier --no-config --single-quote --trailing-comma none --print-width 100 --check .",
    "comments:check": "node scripts/check-no-comments.mjs",
    "rig:check": "python -m py_compile tools/rig/run_server.py tools/rig/launch.py tools/rig/console_helper.py tools/rig/iostore_peek.py tools/rig/spud_peek.py tools/rig/usmap_peek.py",
    "facts:extract": "python tools/gamefacts/extract.py",
    "facts:check": "python -m unittest discover -s tools/gamefacts -p \"test_*.py\"",
    "facts:build": "node scripts/dragonwilds-build.mjs",
    "savereader:build": "node scripts/go.mjs savereader build",
    "savereader:test": "node scripts/go.mjs savereader test",
    "savereader:vet": "node scripts/go.mjs savereader vet",
    "mod:check": "node scripts/mod-package.mjs",
    "mod:package": "node scripts/mod-package.mjs --out dist/mod",
    "verify:quick": "npm run format:check && npm run comments:check && npm run mod:check && npm run savereader:vet",
    "verify": "npm run verify:quick && npm run rig:check && npm run facts:check && npm run savereader:test && npm run savereader:build"
  },
  "devDependencies": {
    "luaparse": "0.3.1",
    "prettier": "3.9.9",
    "sharp": "0.34.5"
  }
}
